{
  "manifest_version": 3,
  "name": "Devlog Downloader",
  "version": "1.0.0",
  "description": "Download devlogs from Stardance as ZIP with Markdown and media.",
  "browser_specific_settings": {
    "gecko": {
      "id": "devlog-downloader@hackclub.com"
    }
  },
  "data_collection_permissions": {
    "required": ["none"]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.hackclub.com/*"],
      "js": ["content.js"]
    }
  ]
}
