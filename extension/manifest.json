{
  "manifest_version": 3,
  "name": "Devlog Downloader",
  "version": "1.0.0",
  "description": "Download devlogs from Stardance as ZIP with Markdown and media.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "*://*.hackclub.com/*",
    "*://*.amazonaws.com/*",
    "*://cachet.dunkirk.sh/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.hackclub.com/*"],
      "js": ["content.js"]
    }
  ]
}
