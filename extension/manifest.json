{
  "manifest_version": 3,
  "name": "Devlog Downloader",
  "version": "1.0.0",
  "description": "Download devlogs from Stardance as ZIP with Markdown and media.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.hackclub.com/*"],
      "js": ["content.js"]
    }
  ]
}
